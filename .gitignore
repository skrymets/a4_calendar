# Local Python environment left over from the retired Python version
.venv/

# Build output. go/build.ps1 writes the binaries to go/dist/; the release workflow stages
# and packs the archives in dist/. Both only ever hold generated, versioned artefacts.
go/dist/
/dist/

# Generated calendars. The program writes calendar_<start>[_<period>].pdf into the
# current directory by default; the repository itself tracks no PDFs.
calendar_*.pdf
/*.pdf

# Local tooling: assistant notes and workspaces, editors, OS noise
CLAUDE.md
.claude/
.superpowers/
.idea/
.vscode/
Thumbs.db
desktop.ini
shortcuts.txt
docs/superpowers/
